# Copy this file to `.env` in the repository root.
# Never commit real secrets or live user data.

# --- Backend ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
LOG_LEVEL=info
TRUST_PROXY=false

# Persistent JSON storage. Use an absolute path on a mounted volume in production.
DATA_DIR=./data
GENERATED_DIR=./generated
PDF_RETENTION_HOURS=24

# --- Website ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=E-Patti

# --- Mobile (Expo) ---
# Android emulator: http://10.0.2.2:4000/api
# Physical device: http://YOUR_LAN_IP:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
